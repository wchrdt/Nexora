{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora",
  "version": "1.9.21",
  "identifier": "app.nexora.island",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexora",
        "width": 1200,
        "height": 820,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5Mzc4NTFBOUVGQTgzQzIKUldUQ2cvcWVHb1UzeVZ5UnA1OU9wVFZvVjllVWJpa0VXR3ZqRzgrQyt5Q1ZBaW9kai9oRFQyOWMK",
      "endpoints": [
        "https://github.com/wchrdt/Nexora/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": { "../xray/**/*": "xray/", "../zapret/**/*": "zapret/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "languages": ["Russian"],
        "installMode": "currentUser"
      }
    }
  }
}
